@startuml conceptual-er-domain
!theme plain
skinparam linetype ortho
skinparam roundcorner 8
skinparam shadowing false

title Предметная ER-модель\n(управление инцидентами, кейсами и корректирующими действиями)

legend right
  Кардинальность:
  ||--o{ : один — много (ноль и более)
  ||--o| : один — ноль или один
  Бизнес-ограничение: на одну пару\n«инцидент + находка + исполнитель»\nприходится не более одного кейса.
end legend

entity "Инцидент" as incident {
  статус
  дата разрешения
}

entity "Находка" as finding {
  приоритет
  срок
  описание
}

entity "Кейс" as case {
  исполнитель
  этап обработки
}

entity "Расследование" as investigation {
  материалы и ход расследования
  установленная причина
  требуются корректирующие действия
}

entity "Комментарий" as comment {
  автор
  текст
  момент публикации
}

entity "Вложение" as attachment {
  кто приложил
  название файла
}

entity "План корректирующих действий" as plan {
  название
  суть и пояснения
}

entity "Задача плана" as task {
  название
  срок
  статус выполнения
  факт завершения
}

entity "Доказательство по задаче" as evidence {
  кто приложил
  наименование материала
  момент прикрепления
}

entity "Приёмка плана" as verification {
  принято
  ответственный за проверку
  замечания
}

incident ||--o{ finding : «включает»
incident ||--o{ case : «обрабатывается через»
finding ||--o{ case : «закреплена в»

case ||--o| investigation : «может сопровождаться»
case ||--o{ comment : «обсуждается»
case ||--o{ attachment : «содержит материалы»

case ||--o| plan : «не более одного плана»
plan ||--o{ task : «разбит на»
plan ||--o| verification : «не более одной приёмки»

task ||--o{ evidence : «подкрепляется»

@enduml
