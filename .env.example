# Скопируйте в .env и при необходимости измените значения:
#   cp .env.example .env
#
# Инфраструктура (отдельно):
#   docker compose -f docker-compose.infra.yml up -d
# Сервис + MinIO:
#   docker compose up -d --build

PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cms_workflow
DB_RUN_MIGRATIONS=true
DB_SYNCHRONIZE=false

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=cms-workflow-service
KAFKA_INCIDENT_TOPIC=cms.incident.events

MINIO_ENDPOINT=localhost
MINIO_PORT=9020
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cms-workflow-attachments

# Внешние CMS-сервисы
CMS_AUTH_SERVICE_URL=http://localhost:9091
CMS_MONITORING_SERVICE_URL=http://localhost:9093
CMS_RISK_SERVICE_URL=http://localhost:9094
CMS_COMPANY_INFO_SERVICE_URL=http://localhost:9092

OUTBOX_RESOLVER_INTERVAL_MINUTES=1
